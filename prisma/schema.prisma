generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlanoTipo {
  ENEM
  PAS
  CONCURSO_PUBLICO
  VESTIBULAR
  OUTRO
}

enum MaterialTipo {
  PDF
  SLIDE
  DOCUMENTO
  TEXTO
  ANOTACAO
  LINK
}

enum RevisaoStatus {
  PENDENTE
  CONCLUIDA
}

enum DificuldadeEstudo {
  FACIL
  MEDIO
  DIFICIL
}

model Usuario {
  id                 String              @id @default(cuid())
  nome               String              @map("name")
  email              String              @unique
  senhaHash          String              @map("passwordHash")
  emailVerificadoEm  DateTime?           @map("emailVerifiedAt")
  criadoEm           DateTime            @default(now()) @map("createdAt")
  atualizadoEm       DateTime            @updatedAt @map("updatedAt")
  planos             PlanoEstudo[]
  materiais          MaterialEstudo[]
  tokensVerificacao  TokenVerificacao[]
  tokensRedefinicao  TokenRedefinicaoSenha[]
  sessoes            Sessao[]
  sessoesEstudo      SessaoEstudo[]

  @@map("User")
}

model Sessao {
  id          String   @id @default(cuid())
  usuarioId   String
  tokenHash   String   @unique
  expiraEm    DateTime
  criadoEm    DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model TokenVerificacao {
  id          String   @id @default(cuid())
  usuarioId   String
  tokenHash   String   @unique
  expiraEm    DateTime
  criadoEm    DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model TokenRedefinicaoSenha {
  id          String   @id @default(cuid())
  usuarioId   String
  tokenHash   String   @unique
  expiraEm    DateTime
  criadoEm    DateTime @default(now())
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiraEm])
}

model PlanoEstudo {
  id          String          @id @default(cuid())
  usuarioId   String
  titulo      String
  tipo        PlanoTipo       @default(OUTRO)
  descricao   String?
  cor         String          @default("#166534")
  arquivado   Boolean         @default(false)
  criadoEm    DateTime        @default(now())
  atualizadoEm DateTime       @updatedAt
  usuario     Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  materias    MateriaEstudo[]
  materiais   MaterialEstudo[]

  @@index([usuarioId, arquivado])
}

model MateriaEstudo {
  id          String       @id @default(cuid())
  planoId     String
  titulo      String
  ordem       Int          @default(0)
  plano       PlanoEstudo  @relation(fields: [planoId], references: [id], onDelete: Cascade)
  topicos     TopicoEstudo[]
  materiais   MaterialEstudo[]

  @@index([planoId, ordem])
}

model TopicoEstudo {
  id          String          @id @default(cuid())
  materiaId   String
  topicoPaiId String?
  titulo      String
  ordem       Int             @default(0)
  criadoEm    DateTime        @default(now())
  atualizadoEm DateTime       @updatedAt
  materia     MateriaEstudo   @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  topicoPai   TopicoEstudo?  @relation("HierarquiaTopicos", fields: [topicoPaiId], references: [id], onDelete: Cascade)
  subtopicos  TopicoEstudo[] @relation("HierarquiaTopicos")
  materiais   MaterialEstudo[]

  @@index([materiaId, topicoPaiId, ordem])
  @@unique([materiaId, topicoPaiId, titulo])
}

model MaterialEstudo {
  id                String            @id @default(cuid())
  usuarioId         String
  planoId           String?
  materiaId         String?
  topicoId          String?
  titulo            String
  nomeArquivo       String?
  urlArquivo        String?
  urlExterna        String?
  conteudo          String?
  tipo              MaterialTipo      @default(PDF)
  tamanhoBytes      Int?
  paginas           Int?
  resumo            String?
  pontosEstudo      String[]          @default([])
  analiseStatus     String            @default("PENDENTE")
  analiseErro       String?
  analiseIniciadaEm  DateTime?
  paginaAtual       Int?
  concluidoEm       DateTime?
  ultimoAcessoEm    DateTime?
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt
  usuario           Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  plano             PlanoEstudo?      @relation(fields: [planoId], references: [id], onDelete: SetNull)
  materia           MateriaEstudo?    @relation(fields: [materiaId], references: [id], onDelete: SetNull)
  topico            TopicoEstudo?     @relation(fields: [topicoId], references: [id], onDelete: SetNull)
  palavrasChave     PalavraChave[]
  revisoes          Revisao[]
  sessoesEstudo     SessaoEstudo[]

  @@index([usuarioId, criadoEm])
  @@index([usuarioId, ultimoAcessoEm])
  @@index([planoId])
  @@index([materiaId])
  @@index([topicoId])
}

model SessaoEstudo {
  id               String             @id @default(cuid())
  usuarioId        String
  materialId       String
  iniciadaEm       DateTime           @default(now())
  finalizadaEm     DateTime?
  duracaoSegundos  Int?
  dificuldade      DificuldadeEstudo?
  criadoEm         DateTime           @default(now())
  usuario          Usuario            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  material         MaterialEstudo     @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([usuarioId, iniciadaEm])
  @@index([materialId, iniciadaEm])
  @@index([usuarioId, finalizadaEm])
  @@map("SessaoEstudoOrganiza")
}

model PalavraChave {
  id          String           @id @default(cuid())
  materialId  String
  termo       String
  criadoEm    DateTime         @default(now())
  material    MaterialEstudo   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([materialId, termo])
  @@index([termo])
}

model Revisao {
  id          String         @id @default(cuid())
  materialId  String
  titulo      String
  agendadaPara DateTime
  concluidaEm DateTime?
  status      RevisaoStatus  @default(PENDENTE)
  criadoEm    DateTime       @default(now())
  material    MaterialEstudo @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([agendadaPara, status])
  @@index([materialId])
}
